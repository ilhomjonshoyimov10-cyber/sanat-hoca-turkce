# Ishlab chiqish (lokal) uchun. Bu faylni `.env` nomi bilan nusxalang va to'ldiring.
# Ishlab chiqarish (server) uchun: deploy/.env.production.example
# .env faylini HECH QACHON git'ga yuklamang!
#
# MUHIM: baza va Redis parollarini HEX ko'rinishida yarating: openssl rand -hex 24
# (base64 dagi / + = belgilari DATABASE_URL ni buzadi)

# ───────── PostgreSQL ─────────
POSTGRES_USER=sanat
POSTGRES_PASSWORD=
POSTGRES_DB=sanat_hoca
# Yuqoridagi parolni PAROL_SHU_YERGA o'rniga ham yozing (bir xil bo'lsin):
DATABASE_URL="postgresql://sanat:PAROL_SHU_YERGA@127.0.0.1:5432/sanat_hoca?schema=public"

# ───────── Redis ─────────
REDIS_PASSWORD=
REDIS_URL="redis://:PAROL_SHU_YERGA@127.0.0.1:6379"

# ───────── Maxfiy kalitlar (har biri alohida, kamida 32 belgi) ─────────
# Yaratish: openssl rand -base64 48
JWT_ACCESS_SECRET=
TOTP_ENCRYPTION_KEY=

# ───────── Ilova ─────────
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
WEB_URL=http://localhost:3000

# ───────── Birinchi administrator (faqat seed uchun) ─────────
# `pnpm db:seed` ishlatilgach, bu ikki qatorni O'CHIRING.
ADMIN_EMAIL=
ADMIN_PASSWORD=
