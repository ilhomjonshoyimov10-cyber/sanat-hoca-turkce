# Ishlab chiqarish sozlamalari. Bu faylni server'da `.env` nomi bilan nusxalang va to'ldiring.
# .env faylini HECH QACHON git'ga yuklamang va hech kimga yubormang.

# ───────── Domen ─────────
SITE_DOMAIN=sanathoca.uz
API_DOMAIN=api.sanathoca.uz
# Let's Encrypt sertifikat muddati tugashidan oldin shu manzilga xabar yuboradi
ACME_EMAIL=siz@example.com

# ───────── Baza va Redis ─────────
# Parollarni HEX ko'rinishida yarating: openssl rand -hex 24
POSTGRES_USER=sanat
POSTGRES_PASSWORD=
POSTGRES_DB=sanat_hoca
REDIS_PASSWORD=

# ───────── Maxfiy kalitlar (har biri alohida) ─────────
# Yaratish: openssl rand -base64 48   (kamida 32 belgi)
JWT_ACCESS_SECRET=
TOTP_ENCRYPTION_KEY=

# ───────── Birinchi administrator (faqat bir marta) ─────────
# `pnpm db:seed` ishlatilgach, bu ikki qatorni fayldan O'CHIRING.
ADMIN_EMAIL=
ADMIN_PASSWORD=
